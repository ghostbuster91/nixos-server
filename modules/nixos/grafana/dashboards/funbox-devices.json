{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "refresh": "1m",
  "schemaVersion": 41,
  "tags": ["funbox", "network", "devices"],
  "templating": { "list": [] },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "FunBox / Network Devices",
  "uid": "funbox-network-devices",
  "version": 1,
  "panels": [
    { "type": "row", "id": 1, "title": "Overview", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "panels": [] },
    {
      "id": 2, "type": "stat", "title": "Online devices",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "editorMode": "code", "expr": "funbox_online_devices{instance=~\"surfer.*\"}", "legendFormat": "online", "range": true, "refId": "A" } ]
    },
    {
      "id": 3, "type": "stat", "title": "Known devices",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "text" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "none", "graphMode": "area", "justifyMode": "auto" },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "editorMode": "code", "expr": "funbox_known_devices{instance=~\"surfer.*\"}", "legendFormat": "known", "range": true, "refId": "A" } ]
    },
    {
      "id": 4, "type": "timeseries", "title": "Online device count over time",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 1, "showPoints": "never", "stepInterpolation": true }, "unit": "short", "min": 0 }, "overrides": [] },
      "options": { "legend": { "calcs": ["lastNotNull", "max", "min"], "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "editorMode": "code", "expr": "funbox_online_devices{instance=~\"surfer.*\"}", "legendFormat": "online", "range": true, "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "editorMode": "code", "expr": "funbox_known_devices{instance=~\"surfer.*\"}", "legendFormat": "known", "range": true, "refId": "B" }
      ]
    },
    { "type": "row", "id": 10, "title": "Connected devices", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 }, "panels": [] },
    {
      "id": 11, "type": "table", "title": "Devices",
      "description": "One row per device known to the FunBox. Status comes from the API 'Active' flag. interface_type is unreliable (downstream Wi-Fi shows as Ethernet) -- use the Surfer Wi-Fi dashboard for real per-client Wi-Fi link data.",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 7 },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": true }, "unit": "none" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Status" }, "properties": [
            { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } },
            { "id": "mappings", "value": [ { "type": "value", "options": { "0": { "text": "Offline", "color": "red", "index": 0 }, "1": { "text": "Online", "color": "green", "index": 1 } } } ] },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } },
            { "id": "custom.width", "value": 90 }
          ] },
          { "matcher": { "id": "byName", "options": "Last connection" }, "properties": [ { "id": "unit", "value": "dateTimeFromNow" } ] },
          { "matcher": { "id": "byName", "options": "First seen" }, "properties": [ { "id": "unit", "value": "dateTimeFromNow" } ] }
        ]
      },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false }, "sortBy": [ { "displayName": "Status", "desc": true } ] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "editorMode": "code", "expr": "funbox_device_active{instance=~\"surfer.*\"} * on (mac) group_left (name, ip, device_type, reserved) funbox_device_info{instance=~\"surfer.*\"}", "legendFormat": "Status", "format": "table", "instant": true, "range": false },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "editorMode": "code", "expr": "funbox_device_last_connection_seconds{instance=~\"surfer.*\"} * 1000", "legendFormat": "Last connection", "format": "table", "instant": true, "range": false },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "editorMode": "code", "expr": "funbox_device_first_seen_seconds{instance=~\"surfer.*\"} * 1000", "legendFormat": "First seen", "format": "table", "instant": true, "range": false }
      ],
      "transformations": [
        { "id": "joinByField", "options": { "byField": "mac", "mode": "outer" } },
        { "id": "organize", "options": {
          "excludeByName": { "Time 1": true, "Time 2": true, "Time 3": true, "__name__": true, "instance": true, "job": true, "interface_type": true },
          "indexByName": { "name": 0, "ip": 1, "mac": 2, "device_type": 3, "reserved": 4, "Value #A": 5, "Value #B": 6, "Value #C": 7 },
          "renameByName": { "name": "Name", "ip": "IP", "mac": "MAC", "device_type": "Type", "reserved": "DHCP reserved", "Value #A": "Status", "Value #B": "Last connection", "Value #C": "First seen" }
        } }
      ]
    },
    { "type": "row", "id": 20, "title": "Availability & history", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 }, "panels": [] },
    {
      "id": 21, "type": "state-timeline", "title": "Device availability (online/offline)",
      "description": "Per-device online/offline history. Series are labelled by device name via join on MAC.",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 22 },
      "fieldConfig": {
        "defaults": { "custom": { "fillOpacity": 80, "lineWidth": 0 }, "unit": "short",
          "mappings": [ { "type": "value", "options": { "0": { "text": "offline", "color": "red", "index": 0 }, "1": { "text": "online", "color": "green", "index": 1 } } } ],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } },
        "overrides": []
      },
      "options": { "mergeValues": true, "showValue": "never", "alignValue": "left", "rowHeight": 0.9, "legend": { "showLegend": false, "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "editorMode": "code", "expr": "funbox_device_active{instance=~\"surfer.*\"} * on (mac) group_left (name) funbox_device_info{instance=~\"surfer.*\"}", "legendFormat": "{{name}}", "range": true, "refId": "A" } ]
    },
    {
      "id": 22, "type": "table", "title": "Newly seen devices (most recent first)",
      "description": "Sorted by first-seen descending. A device at the top with a recent timestamp is new to the network.",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 34 },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": true }, "unit": "none" },
        "overrides": [ { "matcher": { "id": "byName", "options": "First seen" }, "properties": [ { "id": "unit", "value": "dateTimeFromNow" } ] } ]
      },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false }, "sortBy": [ { "displayName": "First seen", "desc": true } ] },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "editorMode": "code", "expr": "funbox_device_first_seen_seconds{instance=~\"surfer.*\"} * 1000 * on (mac) group_left (name, ip) funbox_device_info{instance=~\"surfer.*\"}", "legendFormat": "First seen", "format": "table", "instant": true, "range": false } ],
      "transformations": [
        { "id": "organize", "options": {
          "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true, "device_type": true, "interface_type": true, "reserved": true },
          "indexByName": { "name": 0, "ip": 1, "mac": 2, "Value": 3 },
          "renameByName": { "name": "Name", "ip": "IP", "mac": "MAC", "Value": "First seen" }
        } }
      ]
    },
    {
      "id": 23, "type": "table", "title": "Last observed (least recent first)",
      "description": "Sorted by last-connection ascending so stale/absent devices surface at the top.",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 34 },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": true }, "unit": "none" },
        "overrides": [ { "matcher": { "id": "byName", "options": "Last connection" }, "properties": [ { "id": "unit", "value": "dateTimeFromNow" } ] } ]
      },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false }, "sortBy": [ { "displayName": "Last connection", "desc": false } ] },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "editorMode": "code", "expr": "funbox_device_last_connection_seconds{instance=~\"surfer.*\"} * 1000 * on (mac) group_left (name, ip) funbox_device_info{instance=~\"surfer.*\"}", "legendFormat": "Last connection", "format": "table", "instant": true, "range": false } ],
      "transformations": [
        { "id": "organize", "options": {
          "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true, "device_type": true, "interface_type": true, "reserved": true },
          "indexByName": { "name": 0, "ip": 1, "mac": 2, "Value": 3 },
          "renameByName": { "name": "Name", "ip": "IP", "mac": "MAC", "Value": "Last connection" }
        } }
      ]
    },
    { "type": "row", "id": 30, "title": "Collector health", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 44 }, "panels": [] },
    {
      "id": 31, "type": "stat", "title": "Scrape success",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 45 },
      "fieldConfig": { "defaults": { "unit": "short", "mappings": [ { "type": "value", "options": { "0": { "text": "FAILING", "color": "red", "index": 0 }, "1": { "text": "OK", "color": "green", "index": 1 } } } ], "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "none", "justifyMode": "auto" },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "editorMode": "code", "expr": "funbox_scrape_success{instance=~\"surfer.*\"}", "legendFormat": "success", "range": true, "refId": "A" } ]
    },
    {
      "id": 32, "type": "timeseries", "title": "Scrape duration",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "h": 5, "w": 18, "x": 6, "y": 45 },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" }, "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "editorMode": "code", "expr": "funbox_scrape_duration_seconds{instance=~\"surfer.*\"}", "legendFormat": "duration", "range": true, "refId": "A" } ]
    }
  ]
}
